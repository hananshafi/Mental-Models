# Copy to .env, fill only the services you use, then run:
#   set -a; source .env; set +a

OPENAI_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
WANDB_API_KEY=

# Repository-local caches. Override for a larger scratch disk if needed.
HF_HOME=artifacts/huggingface
TRANSFORMERS_CACHE=artifacts/huggingface/transformers
HF_DATASETS_CACHE=artifacts/huggingface/datasets

# Optional model override used by SOTOPIA launchers.
MENTAL_MODELS_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
